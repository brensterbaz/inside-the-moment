{
  "name": "inside-the-moment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:foundry": "node scripts/dev-foundry.mjs",
    "foundry:server": "tsx server/index.ts",
    "foundry:smoke": "tsx scripts/foundry-smoke.ts",
    "build": "tsc --noEmit && vite build",
    "build:https": "npm run build && node scripts/prepare-hosting.mjs",
    "build:headset": "tsc --noEmit && node scripts/build-headset.mjs",
    "headset:serve": "tsx server/headset.ts",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "foundry-local-sdk": "2.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
